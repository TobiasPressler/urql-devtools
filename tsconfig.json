{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "lib": ["dom", "esnext"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@types/chrome", "jest"]
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "src/**/*.test.*",
    "src/**/*.fixture.*",
    "src/setupTests.ts",
    "src/panel/cosmos.*"
  ]
}
