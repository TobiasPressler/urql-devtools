{
  "name": "urql-devtools",
  "version": "2.6.3",
  "description": "The official devtools utility for urql",
  "homepage": "https://www.github.com/FormidableLabs/urql-devtools",
  "bugs": {
    "url": "https://github.com/FormidableLabs/urql-devtools/issues"
  },
  "repository": "https://www.github.com/FormidableLabs/urql-devtools",
  "license": "MIT",
  "author": "Formidable",
  "keywords": [
    "urql",
    "devtools",
    "extension",
    "electron",
    "react native"
  ],
  "scripts": {
    "prepare": "node ./scripts/postinstall.js",
    "build": "pnpm run build:extension && pnpm run build:electron",
    "build:electron": "export NODE_ENV=production; export BUILD_ENV=electron; pnpm tsup",
    "build:extension": "export NODE_ENV=production; export BUILD_ENV=extension; pnpm tsup",
    "bundle": "cd dist/extension && bestzip ../../extension.zip *",
    "cosmos": "export BUILD_ENV=electron; cosmos",
    "cosmos:build": "export BUILD_ENV=electron; pnpm run cosmos-export && node scripts/cosmos-add-badge.js",
    "dev": "concurrently \"npm:dev:extension\" \"npm:dev:electron\"",
    "dev:electron": "export BUILD_ENV=electron; pnpm tsup --watch",
    "dev:extension": "export BUILD_ENV=extension; pnpm tsup --watch",
    "lint": "eslint --ext .ts,.tsx src",
    "lint:firefox": "cd dist/extension && web-ext lint",
    "lint:prettier": "prettier -c .",
    "start": "electron dist/electron/main.js",
    "test": "NODE_ENV=test jest",
    "type-check": "tsc"
  },
  "bin": "./scripts/cli.js",
  "engines": {
    "node": ">= 14"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm lint-staged"
    }
  },
  "lint-staged": {
    "*.{json,js,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@codemirror/language": "^6.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.2.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@urql/core": "^2.0.5",
    "@urql/devtools": "^2.0.3",
    "codemirror": "^5.57.0",
    "codemirror-graphql": "^2.0.2",
    "electron": "^13.1.5",
    "fast-json-stable-stringify": "^2.1.0",
    "graphql": "^16.6.0",
    "jest-environment-jsdom": "^29.4.2",
    "prismjs": "^1.29.0",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "react-is": "^17.0.0",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0",
    "react-spring": "^8.0.27",
    "styled-components": "^5.1.1",
    "ws": "^7.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.25.2",
    "@changesets/get-github-info": "^0.5.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@svgr/rollup": "^8.1.0",
    "@types/chrome": "^0.2.8",
    "@types/codemirror": "0.0.97",
    "@types/d3-scale": "^2.2.0",
    "@types/enzyme": "^3.10.5",
    "@types/enzyme-adapter-react-16": "^1.0.6",
    "@types/fast-json-stable-stringify": "^2.0.0",
    "@types/jest": "^29.4.0",
    "@types/jest-environment-puppeteer": "^5.0.0",
    "@types/nanoid": "^2.1.0",
    "@types/prismjs": "^1.16.1",
    "@types/puppeteer": "^3.0.1",
    "@types/react": "^16.9.49",
    "@types/react-dom": "^16.9.8",
    "@types/react-router": "^5.1.8",
    "@types/react-router-dom": "^5.1.5",
    "@types/resize-observer-browser": "^0.1.3",
    "@types/semver": "^7.3.3",
    "@types/styled-components": "^5.1.3",
    "@types/ws": "^7.2.6",
    "@typescript-eslint/eslint-plugin": "^4.3.0",
    "@typescript-eslint/parser": "^4.3.0",
    "@wojtekmaj/enzyme-adapter-react-17": "^0.8.0",
    "bestzip": "^2.1.7",
    "d3-scale": "^3.2.2",
    "dotenv": "^8.2.0",
    "enzyme": "^3.11.0",
    "enzyme-to-json": "^3.5.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-svgr": "^3.1.1",
    "esbuild-plugins-node-modules-polyfill": "^1.8.3",
    "eslint": "^7.8.1",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-react": "^7.20.6",
    "husky-v4": "^4.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.4.0",
    "jest-styled-components": "^7.1.0",
    "lint-staged": "^10.3.0",
    "mitt": "^3.0.0",
    "nanoid": "^3.0.0",
    "polished": "^3.6.6",
    "prettier": "^2.1.1",
    "puppeteer": "^25.10.0",
    "react-cosmos": "5.6.2",
    "semver": "^7.3.2",
    "terser": "^5.51.2",
    "ts-jest": "^29.0.0",
    "tsup": "^8.5.1",
    "typescript": "^4.9.3",
    "wait-on": "^6.0.1",
    "web-ext": "^5.1.0"
  }
}
