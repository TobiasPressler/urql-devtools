{
  "name": "urql-devtools",
  "version": "2.6.3",
  "description": "The official devtools utility for urql",
  "homepage": "https://www.github.com/FormidableLabs/urql-devtools",
  "bugs": {
    "url": "https://github.com/FormidableLabs/urql-devtools/issues"
  },
  "repository": "https://www.github.com/FormidableLabs/urql-devtools",
  "license": "MIT",
  "author": "Formidable",
  "keywords": [
    "urql",
    "devtools",
    "extension",
    "electron",
    "react native"
  ],
  "scripts": {
    "prepare": "node ./scripts/postinstall.js",
    "build": "pnpm run build:extension && pnpm run build:electron",
    "build:electron": "export NODE_ENV=production; export BUILD_ENV=electron; pnpm tsup",
    "build:extension": "export NODE_ENV=production; export BUILD_ENV=extension; pnpm tsup",
    "bundle": "cd dist/extension && bestzip ../../extension.zip *",
    "cosmos": "export BUILD_ENV=electron; cosmos",
    "cosmos:build": "export BUILD_ENV=electron; pnpm run cosmos-export && node scripts/cosmos-add-badge.js",
    "dev": "concurrently \"npm:dev:extension\" \"npm:dev:electron\"",
    "dev:electron": "export BUILD_ENV=electron; pnpm tsup --watch",
    "dev:extension": "export BUILD_ENV=extension; pnpm tsup --watch",
    "lint": "eslint --ext .ts,.tsx src",
    "lint:firefox": "cd dist/extension && web-ext lint",
    "lint:prettier": "prettier -c .",
    "start": "electron dist/electron/main.js",
    "test": "NODE_ENV=test jest",
    "type-check": "tsc"
  },
  "bin": "./scripts/cli.js",
  "engines": {
    "node": ">= 20"
  },
  "packageManager": "pnpm@11.24.0",
  "husky": {
    "hooks": {
      "pre-commit": "pnpm lint-staged"
    }
  },
  "lint-staged": {
    "*.{json,js,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@urql/core": "^6.0.3",
    "@urql/devtools": "^2.0.3",
    "codemirror": "^5.65.21",
    "codemirror-graphql": "^2.2.9",
    "electron": "^44.2.0",
    "fast-json-stable-stringify": "^2.1.0",
    "graphql": "^17.0.2",
    "jest-environment-jsdom": "^30.5.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-router": "^8.3.1",
    "react-router-dom": "^7.18.3",
    "react-spring": "^10.0.4",
    "styled-components": "^6.5.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@changesets/get-github-info": "^1.0.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@svgr/rollup": "^8.1.0",
    "@types/chrome": "^0.2.8",
    "@types/codemirror": "5.60.18",
    "@types/d3-scale": "^4.0.9",
    "@types/enzyme": "^3.10.19",
    "@types/enzyme-adapter-react-16": "^1.0.9",
    "@types/fast-json-stable-stringify": "^2.1.2",
    "@types/jest": "^30.0.0",
    "@types/jest-environment-puppeteer": "^5.0.6",
    "@types/nanoid": "^3.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/puppeteer": "^7.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/resize-observer-browser": "^0.1.11",
    "@types/semver": "^7.8.0",
    "@types/styled-components": "^5.1.36",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@wojtekmaj/enzyme-adapter-react-17": "^0.8.0",
    "bestzip": "^3.0.3",
    "d3-scale": "^4.0.2",
    "dotenv": "^17.4.2",
    "enzyme": "^3.11.0",
    "enzyme-to-json": "^3.6.2",
    "esbuild": "^0.28.2",
    "esbuild-plugin-svgr": "^3.1.1",
    "esbuild-plugins-node-modules-polyfill": "^1.8.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "husky-v4": "^4.3.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-styled-components": "^7.4.0",
    "lint-staged": "^17.4.1",
    "mitt": "^3.0.1",
    "nanoid": "^6.0.1",
    "polished": "^4.3.1",
    "prettier": "^3.9.6",
    "puppeteer": "^25.10.0",
    "react-cosmos": "7.4.1",
    "semver": "^7.8.5",
    "terser": "^5.51.2",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "wait-on": "^9.1.0",
    "web-ext": "^10.6.0"
  }
}
